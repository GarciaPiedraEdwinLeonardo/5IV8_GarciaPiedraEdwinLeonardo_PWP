<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edicion de datos de estudiante</title>
</head>
<body>
    <h1>Actualizacion de datos del estudiante</h1>
    
    <form action="/estudiantes/uptade/<%= estudiante.id %>" method="POST">
        <div class="title-container">
            <h2>Actualizar datos</h2>
        </div>
        
        <div class="input-container">
            <div class="campo">
                <label for="nombre">Nombre: </label>
                <input type="text" id="nombre" name="nombre" value="<%= estudiante.nombre %>" required>
            </div>
            
            <div class="campo">
                <label for="edad">Edad: </label>
                <input type="number" id="edad" name="edad" value="<%= estudiante.edad %>" required>
            </div>
            
            <div class="campo">
                <label for="curso">Curso: </label>
                <input type="text" id="curso" name="curso" value="<%= estudiante.curso %>" required>
            </div>
        </div>
        
        <div class="button">
            <button type="submit">Actualizar datos</button>
        </div>
    </form>
</body>
</html>