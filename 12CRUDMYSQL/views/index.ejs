<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registro de Estudiantes</title>
    <link rel="stylesheet" href="./../css/style.css ">

</head>
<body>
    <h1>Registro de Estudiantes</h1>
    
    <form action="/estudiantes" method="POST">
        <div class="title-container">
            <h2>Agregar Nuevo Estudiante</h2>
        </div>
        
        <div class="input-container">
            <div class="campo">
                <label for="nombre">Nombre: </label>
                <input type="text" id="nombre" name="nombre" required>
            </div>
            
            <div class="campo">
                <label for="edad">Edad: </label>
                <input type="number" id="edad" name="edad" required>
            </div>
            
            <div class="campo">
                <label for="curso">Curso: </label>
                <input type="text" id="curso" name="curso" required>
            </div>
        </div>
        
        <div class="button">
            <button type="submit">Registrar Estudiante</button>
        </div>
    </form>

    <div class="lista-estudiantes">
        <h2>Estudiantes Registrados</h2>
        <ul>
            <% estudiantes.forEach(function(estudiante) { %>
                <li>
                    <div class="info-estudiante">
                        <strong><%= estudiante.nombre %></strong> (Edad: <%= estudiante.edad %>, Curso: <%= estudiante.curso %>)
                    </div>
                    <div class="acciones-estudiante">
                        <a href="/estudiantes/edit/<%= estudiante.id %>">Editar</a>
                        <a href="/estudiantes/delete/<%= estudiante.id %>">Eliminar</a>
                    </div>
                </li>
            <% }) %>
        </ul>
    </div>
</body>
</html>